DATABASE_URL="postgresql://racelineup:CHANGE_ME@db:5432/racelineup"
AUTH_SECRET="generate-a-long-random-string-here"

# Postgres container credentials (used by docker-compose.yml)
POSTGRES_USER="racelineup"
POSTGRES_PASSWORD="CHANGE_ME"
POSTGRES_DB="racelineup"

# Only needed if you're using the GitHub Actions -> ECR pipeline (see
# README "Continuous deployment"). Leave unset to build the image locally.
# APP_IMAGE="123456789012.dkr.ecr.us-east-1.amazonaws.com/racelineup:latest"
