generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  PROMOTER
}

enum ScheduleType {
  PRACTICE
  RACE
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  username     String?  @unique
  passwordHash String
  name         String
  role         Role     @default(PROMOTER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  events Event[]
}

model Event {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  location  String
  eventDate DateTime @db.Date
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  promoterId String
  promoter   User   @relation(fields: [promoterId], references: [id], onDelete: Cascade)

  activeSchedule ScheduleType @default(RACE)

  races            Race[]
  practiceSessions PracticeSession[]

  currentRaceId String? @unique
  currentRace   Race?   @relation("CurrentRace", fields: [currentRaceId], references: [id], onDelete: SetNull)

  currentPracticeId String?          @unique
  currentPractice   PracticeSession? @relation("CurrentPractice", fields: [currentPracticeId], references: [id], onDelete: SetNull)
}

model Race {
  id         String @id @default(cuid())
  raceNumber Int
  position   Int
  laps       Int

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  gateDrops GateDrop[]

  currentForEvent Event? @relation("CurrentRace")

  @@unique([eventId, position])
}

model PracticeSession {
  id             String @id @default(cuid())
  practiceNumber Int
  description    String
  laps           Int?
  minutes        Int?
  position       Int

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  currentForEvent Event? @relation("CurrentPractice")

  @@unique([eventId, position])
}

model GateDrop {
  id         String @id @default(cuid())
  gateNumber Int
  position   Int

  raceId String
  race   Race   @relation(fields: [raceId], references: [id], onDelete: Cascade)

  classEntries ClassEntry[]

  @@unique([raceId, position])
}

model ClassEntry {
  id        String @id @default(cuid())
  className String
  numRacers Int

  gateDropId String
  gateDrop   GateDrop @relation(fields: [gateDropId], references: [id], onDelete: Cascade)
}
